MAIN:          OUT INDEX   ; Current Index
               LOAD MAIN_RET_PUSH
               STORE R_ADR

               IN INPUT
               LOAD INPUT
               STORE P_VALUE

               JMP SUB_PUSH ; Push input onto stack
MAIN_RET_PUSH: 0 MAIN_RET_PUSH

               OUT INDEX   ; Current Index
               LOAD MAIN_RET_POP
               STORE R_ADR

               JMP SUB_POP ; Pop input from stack
MAIN_RET_POP:  0 MAIN_RET_POP
               OUT R_VALUE ; Popped value

               JMP END


; ___PUSH_SUB___
;             Indirect store value into index
SUB_PUSH:     LOAD  I_STORE
              ADD   INDEX
              STORE I_STORE_PUSH

              LOAD P_VALUE
I_STORE_PUSH: STORE 0

;             Decrement index
              LOAD  INDEX
              DEC   INDEX

;             Store Indirect jmp to R_ADR at I_JMP_PUSH
              LOAD  I_JMP
              ADD   R_ADR
              STORE I_JMP_PUSH
I_JMP_PUSH:   JMP   0


; ___POP_SUB___
;            Increment index
SUB_POP:     LOAD  INDEX
             INC   INDEX

;            Indirect load value into POP
             LOAD  I_LOAD
             ADD   INDEX
             STORE I_LOAD_POP
I_LOAD_POP:  LOAD  0

             STORE R_VALUE

;            Indirect clear value
             LOAD  I_CLEAR
             ADD   INDEX
             STORE I_CLEAR_POP
I_CLEAR_POP: CLEAR 0

;            Store Indirect jmp to R_ADR at I_JMP_POP
             LOAD  I_JMP
             ADD   R_ADR
             STORE I_JMP_POP
I_JMP_POP:   JMP   0

END:       HALT

INPUT:  .DATA 0

I_LOAD:  LOAD  0
I_STORE: STORE 0
I_JMP:   JMP   0
I_CLEAR: CLEAR 0

R_ADR:     0    END
R_VALUE:  .DATA 0
P_VALUE:  .DATA 0

INDEX:    .DATA FFF