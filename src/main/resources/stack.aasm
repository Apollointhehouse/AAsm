; This program will take integers as input until it receives -1
; From there it will pop and print all the values

MAIN_PUSH:     LOAD MAIN_RET_PUSH
               STORE R_ADR

               IN INPUT
               LOAD INPUT
               STORE P_VALUE
               LOAD P_VALUE
               COMP ZERO
               JMPGT MAIN_POP

               JMP SUB_PUSH ; Push input onto stack
MAIN_RET_PUSH: 0 MAIN_RET_PUSH
               JMP MAIN_PUSH

MAIN_POP:      LOAD MAIN_RET_POP
               STORE R_ADR

               LOAD INDEX
               COMP MAX_INDEX
               JMPEQ MAIN_POP_END
               JMPLT MAIN_POP_END

               JMP SUB_POP ; Pop input from stack
MAIN_RET_POP:  0 MAIN_RET_POP
               OUT R_VALUE ; Popped value
               JMP MAIN_POP
MAIN_POP_END:  HALT


; ___PUSH_SUB___
;             Indirect store value into index
SUB_PUSH:     LOAD  I_STORE
              ADD   INDEX
              STORE I_STORE_PUSH

              LOAD P_VALUE
I_STORE_PUSH: STORE 0

;             Decrement index
              LOAD  INDEX
              DEC   INDEX

;             Store Indirect jmp to R_ADR at I_JMP_PUSH
              LOAD  I_JMP
              ADD   R_ADR
              STORE I_JMP_PUSH
I_JMP_PUSH:   JMP   0


; ___POP_SUB___
;            Increment index
SUB_POP:     LOAD  INDEX
             INC   INDEX

;            Indirect load value into POP
             LOAD  I_LOAD
             ADD   INDEX
             STORE I_LOAD_POP
I_LOAD_POP:  LOAD  0

             STORE R_VALUE

;            Indirect clear value
             LOAD  I_CLEAR
             ADD   INDEX
             STORE I_CLEAR_POP
I_CLEAR_POP: CLEAR 0

;            Store Indirect jmp to R_ADR at I_JMP_POP
             LOAD  I_JMP
             ADD   R_ADR
             STORE I_JMP_POP
I_JMP_POP:   JMP   0

INPUT:  .DATA  0

I_LOAD:  LOAD  0
I_STORE: STORE 0
I_JMP:   JMP   0
I_CLEAR: CLEAR 0

R_ADR:      LOAD 0
R_VALUE:   .DATA 0
P_VALUE:   .DATA 0

ZERO:      .DATA 0
MAX_INDEX: .DATA FFF
INDEX:     .DATA FFF